<?xml version="1.0" encoding="utf-8"?>
<!-- 顶栏左上「地域分组」标签的底。
     改造前这里是一行 11sp 的 #B7C9DA 灰字，实测在遮罩后的顶栏背景
     (47,95,135) 上对比度只有 3.98，又小又灰，要靠找才看得见。
     现在改成胶囊标签：25% 橙底 + 20% 橙描边 + 橙色圆点。
     白字压在胶囊上实测对比度 5.68（背景 47,95,135 只有 3.98）。
     描边用半透明橙而不是实心橙：实心橙填充加白字会变成"按钮"观感，
     而这一处是不可点击的标签。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="#40FF7A45" />
    <stroke android:width="1dp" android:color="#80FF7A45" />
</shape>
